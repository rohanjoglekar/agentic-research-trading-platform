# Copy to stock-options-ai/.env to run the jobs. The tests need none of this.
# Every key is read from the environment; nothing in the repository holds one.

# ── Paper trading (Alpaca). Two separate paper accounts, one per book. ──
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPHA_ALPACA_API_KEY=
ALPHA_ALPACA_SECRET_KEY=
ALPHA_ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Models ──
ANTHROPIC_API_KEY=            # weekly reads, valuation models, fallback for the analysts
GEMINI_API_KEY=               # options research and trade management (Google Search grounding)
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_URL=http://127.0.0.1:11434   # local models: the equity book's review, background research

# ── Data ──
FINNHUB_API_KEY=              # fundamentals and earnings dates for the options scan
SEC_USER_AGENT=               # "Name contact@example.com": SEC EDGAR asks every client to identify itself

# ── Run modes. Each is documented beside its setting in config/settings.py. ──
TRADER_AGENT_MODE=advisory    # options book, the position agent: off | advisory | full_execute
COVERED_CALLS_MODE=advisory   # covered calls on assigned shares: off | advisory | full_execute
ALPHA_MODE=advisory           # equity book: off | advisory | full_execute
ALPHA_GOVERNOR_MODE=advisory  # equity book, the weekly review: off | advisory | apply
USE_MOCK_OPTIONS=true         # true = offline mock option chains, false = live chains

# ── Optional notifications ──
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
